# Secrets & runtime cache — never commit
private/config.php
private/cache/*
!private/cache/.gitkeep

# AeroDataBox backend: deploy-generated key config + on-disk response cache
public/api/config.php
public/api/cache/*
!public/api/cache/.gitkeep
!public/api/cache/.htaccess

# Static data is generated by the GitHub Pages workflow (or build/export_static.php)
public/data/

# Node build tooling
build/node_modules/
build/package-lock.json

# OS / editor
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
